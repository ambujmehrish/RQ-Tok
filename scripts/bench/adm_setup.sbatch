#!/bin/bash
# =====================================================================================
# ImageNet-256 FID / sFID / IS / Precision / Recall: OpenAI's ADM evaluation suite.
#
#   sbatch --qos=gpulongjobs scripts/bench/adm_setup.sbatch
#
# Official: github.com/openai/guided-diffusion @ 22e0df8, evaluations/evaluator.py, its
# Inception-v3 graph, the ImageNet-256 reference batch (VIRTUAL_imagenet256_labeled.npz)
# and ADM's published ADM-G + ADM-U sample batch for calibration — the suite Bifrost-1's
# §5.1 numbers come from (it is the one that computes sFID). The evaluator is used
# unmodified. Its requirements say "tensorflow-gpu>=2.0"; the environment is a lock
# verified here (tensorflow-cpu 2.15.1, numpy 1.23.5 — numpy >= 1.24 removed np.bool,
# which the evaluator's precision/recall uses). Two runs on the same inputs are
# bit-identical with oneDNN off. Calibration (adm_score.sbatch CALIBRATE=1) must reproduce
# the README's published numbers before any model is scored.
# =====================================================================================
#SBATCH --job-name=adm-setup
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --partition=gpus
#SBATCH --gres=gpu:h200:1
# project rule: jobs run on H200 nodes only (the evaluator runs on CPU, deterministically)
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --time=04:00:00
#SBATCH --output=logs/%x-%j.out
#SBATCH --error=logs/%x-%j.out

set -euo pipefail
REPO="${SLURM_SUBMIT_DIR:-$PWD}"
cd "$REPO"
mkdir -p logs
die() { echo "FAILED: $*" >&2; exit 1; }

GD_COMMIT="22e0df8183507e13a7813f8d38d51b072ca1e67c"
BASE="https://openaipublic.blob.core.windows.net/diffusion/jul-2021/ref_batches"
BENCH_ROOT="${BENCH_ROOT:-$HOME/work/bench}"
ADM="$BENCH_ROOT/adm"
ENV_NAME="${ADM_ENV:-admeval}"
mkdir -p "$ADM"

code=$(curl -sS -o /dev/null -m 20 -w '%{http_code}' https://pypi.org || true)
[ "$code" = "200" ] || die "no internet from $(hostname)"

[ -d "$ADM/guided-diffusion/.git" ] || git clone -q https://github.com/openai/guided-diffusion "$ADM/guided-diffusion"
git -C "$ADM/guided-diffusion" fetch -q origin && git -C "$ADM/guided-diffusion" checkout -q "$GD_COMMIT"
[ "$(git -C "$ADM/guided-diffusion" rev-parse HEAD)" = "$GD_COMMIT" ] || die "guided-diffusion not at $GD_COMMIT"

# shellcheck disable=SC1090
source "$HOME/miniforge3/etc/profile.d/conda.sh"
set +u   # conda's activate.d/deactivate.d scripts read unset variables; nounset off for conda only
conda env list | awk '{print $1}' | grep -qx "$ENV_NAME" || conda create -y -q -n "$ENV_NAME" python=3.10
conda activate "$ENV_NAME"
set -u
python -m pip install -q --no-deps -r "$REPO/scripts/bench/adm_requirements.lock.txt"
python -m pip check || die "the ADM evaluator environment is inconsistent"

fetch() {   # $1 = url, $2 = destination: verified byte-range chunks, resumes a .part file
  python "$REPO/scripts/bench/fetch_ranged.py" "$1" "$2" || die "could not download $1 (resubmit to resume)"
}
fetch "$BASE/classify_image_graph_def.pb" "$ADM/classify_image_graph_def.pb"
fetch "$BASE/imagenet/256/VIRTUAL_imagenet256_labeled.npz" "$ADM/VIRTUAL_imagenet256_labeled.npz"
fetch "$BASE/imagenet/256/admnet_guided_upsampled_imagenet256.npz" "$ADM/admnet_guided_upsampled_imagenet256.npz"
python - "$ADM" <<'PY'
import sys
import numpy as np
d = sys.argv[1]
with np.load(f"{d}/VIRTUAL_imagenet256_labeled.npz") as z:
    assert {"mu", "sigma", "mu_s", "sigma_s"} <= set(z.files), z.files
with np.load(f"{d}/admnet_guided_upsampled_imagenet256.npz") as z:
    assert z["arr_0"].shape[1:] == (256, 256, 3) and z["arr_0"].dtype == np.uint8
    print(f"  calibration batch: {z['arr_0'].shape[0]} ADM-G + ADM-U samples")
PY
sha256sum "$ADM"/*.npz "$ADM"/*.pb > "$ADM/SHA256SUMS"
cat > "$BENCH_ROOT/adm_env.sh" <<EOT
# Generated by scripts/bench/adm_setup.sbatch
export ADM_DIR="$ADM"
export ADM_ENV="$ENV_NAME"
export ADM_COMMIT="$GD_COMMIT"
export TF_ENABLE_ONEDNN_OPTS=0
EOT
echo "=== done — next: sbatch --export=ALL,CALIBRATE=1 scripts/bench/adm_score.sbatch ==="
